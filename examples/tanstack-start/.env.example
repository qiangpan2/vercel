# Redis Configuration
REDIS_URL=redis://localhost:6379

# SSO Configuration
SSO_VERIFY_SCRIPT=/opt/sso/verify.py
# SSO 测试模式（默认 true，开发环境自动通过验证；设置为 false 时使用真实 SSO 验证）
SSO_TEST_MODE=true

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production
SESSION_TTL=86400

# Ansible Configuration
ANSIBLE_INVENTORY_PATH=./ansible/inventory/hosts.yml
ANSIBLE_PRIVATE_KEY_PATH=~/.ssh/admin_key

# Worker Configuration
WORKER_CONCURRENCY=3
WORKER_TIMEOUT=1800000

# Machine Configuration
DEFAULT_MAX_SHARED_USERS=5
